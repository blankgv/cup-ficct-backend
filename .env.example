# Copia a .env y completa los valores.

# Nombre de la aplicación.
APP_NAME=
# Entorno: local, production, testing.
APP_ENV=
# Clave de la app. Generar: php artisan key:generate
APP_KEY=
# Modo debug: true o false.
APP_DEBUG=
# URL base del backend.
APP_URL=

# Idioma principal.
APP_LOCALE=
# Idioma de respaldo.
APP_FALLBACK_LOCALE=
# Idioma para datos falsos (faker).
APP_FAKER_LOCALE=

# Canal de logs.
LOG_CHANNEL=
# Stack de logs.
LOG_STACK=
# Canal para deprecaciones.
LOG_DEPRECATIONS_CHANNEL=
# Nivel de log: debug, info, error.
LOG_LEVEL=

# Driver de base de datos (pgsql).
DB_CONNECTION=
# Connection string a PostgreSQL (sin prefijo jdbc:): pgsql://usuario:password@host:puerto/db
DATABASE_URL=

# Secreto para firmar tokens JWT. Generar: php artisan jwt:secret
JWT_SECRET=
# Vida del token en minutos.
JWT_TTL=
# Vida del refresh token en minutos.
JWT_REFRESH_TTL=
# Algoritmo de firma JWT.
JWT_ALGO=
# Margen de tolerancia de tiempo en segundos.
JWT_LEEWAY=
# Activar lista negra de tokens: true o false.
JWT_BLACKLIST_ENABLED=
# Periodo de gracia de la lista negra en segundos.
JWT_BLACKLIST_GRACE_PERIOD=
# Mostrar excepción de token en lista negra: true o false.
JWT_SHOW_BLACKLIST_EXCEPTION=
# Guard de autenticación por defecto.
AUTH_GUARD=

# Host base para la documentación Swagger.
L5_SWAGGER_CONST_HOST=

# Cloudflare R2 (S3) — almacenamiento de archivos.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=
# Carpetas dentro del bucket.
R2_TITULOS_PATH=
R2_FOTOS_PATH=
R2_COMPROBANTES_PATH=
R2_RECIBOS_PATH=

# Stripe (pasarela de pago)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# PayPal (pasarela de pago)
# PAYPAL_BASE_URL: sandbox = https://api-m.sandbox.paypal.com  ·  prod = https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=
PAYPAL_CURRENCY=
PAYPAL_WEBHOOK_ID=
PAYPAL_SUCCESS_URL=
PAYPAL_CANCEL_URL=

# Pasarela de pago por defecto cuando el checkout no especifica una (stripe|paypal)
PAYMENT_DEFAULT_GATEWAY=

# Cobro de inscripción que se genera automáticamente al verificar una postulación
PAYMENT_INSCRIPCION_MONTO=
PAYMENT_INSCRIPCION_CONCEPTO=
PAYMENT_INSCRIPCION_METODO=

# API de feriados (pre-llena la tabla; la facultad luego edita)
# FERIADOS_API_URL: base tipo Nager.Date, ej. https://date.nager.at/api/v3/PublicHolidays  (se le agrega /{gestion}/{pais})
FERIADOS_API_URL=
FERIADOS_PAIS=

# OpenAI (reporte por voz: interpreta el texto y elige reporte + filtros)
# OPENAI_BASE_URL: ej. https://api.openai.com  (se le agrega /v1/chat/completions)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# URL del frontend.
FRONTEND_URL=
# Orígenes permitidos para CORS (separados por comas).
CORS_ALLOWED_ORIGINS=

# Almacén de cache.
CACHE_STORE=
# Driver de sesión.
SESSION_DRIVER=
# Duración de la sesión en minutos.
SESSION_LIFETIME=
# Conexión de la cola.
QUEUE_CONNECTION=
# Conexión de broadcasting.
BROADCAST_CONNECTION=
# Disco de almacenamiento por defecto.
FILESYSTEM_DISK=

# Rondas de hash bcrypt.
BCRYPT_ROUNDS=

# Driver de correo (smtp, log).
MAIL_MAILER=
# Servidor SMTP.
MAIL_HOST=
# Puerto SMTP.
MAIL_PORT=
# Usuario SMTP.
MAIL_USERNAME=
# Contraseña / API key SMTP.
MAIL_PASSWORD=
# Dirección remitente.
MAIL_FROM_ADDRESS=
# Nombre remitente.
MAIL_FROM_NAME=
